---
interface Props {
  whoHref: string;
  orderHref: string;
  topHref: string;
  whoLabel: string;
  orderLabel: string;
  topLabel: string;
  copyright: string;
  /** Always Sanity-sourced (siteSettings.socialLinks), never empty. */
  socialLinks: { platform: string; href: string; iconUrl: string; iconAlt?: string }[];
}

const {
  whoHref,
  orderHref,
  topHref,
  whoLabel,
  orderLabel,
  topLabel,
  copyright,
  socialLinks: links,
} = Astro.props;

function maskStyle(url: string) {
  const escapedUrl = url.replace(/["\\]/g, "\\$&");
  return `mask-image: url("${escapedUrl}"); -webkit-mask-image: url("${escapedUrl}")`;
}
---

<footer
  class="relative w-full bg-brand-blue
         min-h-32 sm:min-h-36 md:min-h-40 lg:min-h-44 xl:min-h-48
         flex flex-col items-center justify-center
         gap-3 sm:gap-4 md:gap-5 lg:gap-6
         px-4 sm:px-6 md:px-10 lg:px-14
         py-6 sm:py-8 md:py-10 lg:py-12"
  data-node-id="3311:1456"
  data-name="Rectangle 37 (footer)"
  aria-label="Site footer"
>
  <nav
    class="flex items-center justify-center
           gap-4 sm:gap-6 md:gap-8 lg:gap-12"
    aria-label="Footer"
  >
    <a
      href={whoHref}
      class="text-white font-medium no-underline whitespace-nowrap
             text-sm sm:text-base md:text-lg lg:text-xl xl:text-2xl
             transition-[transform,filter] duration-150 ease-out
             hover:brightness-90 hover:-translate-y-px
             focus-visible:brightness-90 focus-visible:-translate-y-px focus-visible:outline-hidden"
      data-node-id="3311:1635"
    >{whoLabel}</a>
    <span
      aria-hidden="true"
      class="inline-block bg-white shrink-0 w-px sm:w-0.5
             h-5 sm:h-6 md:h-8 lg:h-10 xl:h-12
             rounded-full"
      data-node-id="3311:1643"
      data-name="Rectangle 38 (divider)"
    ></span>
    <a
      href={orderHref}
      class="text-white font-medium no-underline whitespace-nowrap
             text-sm sm:text-base md:text-lg lg:text-xl xl:text-2xl
             transition-[transform,filter] duration-150 ease-out
             hover:brightness-90 hover:-translate-y-px
             focus-visible:brightness-90 focus-visible:-translate-y-px focus-visible:outline-hidden"
      data-node-id="3311:1631"
    >{orderLabel}</a>
    <span
      aria-hidden="true"
      class="inline-block bg-white shrink-0 w-px sm:w-0.5
             h-5 sm:h-6 md:h-8 lg:h-10 xl:h-12
             rounded-full"
      data-node-id="3311:1644"
      data-name="Rectangle 39 (divider)"
    ></span>
    <a
      href={topHref}
      class="text-white font-medium no-underline whitespace-nowrap
             text-sm sm:text-base md:text-lg lg:text-xl xl:text-2xl
             transition-[transform,filter] duration-150 ease-out
             hover:brightness-90 hover:-translate-y-px
             focus-visible:brightness-90 focus-visible:-translate-y-px focus-visible:outline-hidden"
      data-node-id="3311:1639"
    >{topLabel}</a>
  </nav>

  <div class="flex items-center justify-center gap-4 sm:gap-5 md:gap-6">
    {links.map((link) => (
      <a
        href={link.href}
        class="footer-social"
        style={maskStyle(link.iconUrl)}
        aria-label={`Follow us on ${link.platform}`}
        target="_blank"
        rel="noopener noreferrer"
      ></a>
    ))}
  </div>

  <p
    class="m-0 text-center text-white font-normal
           text-xs sm:text-sm md:text-base lg:text-lg xl:text-xl"
    data-node-id="3311:1670"
  >{copyright}</p>

</footer>
