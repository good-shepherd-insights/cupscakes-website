---
interface Props {
  headline: string;
  headlinePrefix?: string;
  headlineEmphasis?: string;
  headlineSuffix?: string;
  ctaLabel: string;
  ctaAriaLabel: string;
  orderHref: string;
  siteName: string;
  puertoRicoIconSrc?: string;
  puertoRicoIconAccessibleLabel?: string;
  scrollAriaLabel: string;
}

const {
  headline,
  headlinePrefix,
  headlineEmphasis,
  headlineSuffix,
  ctaLabel,
  ctaAriaLabel,
  orderHref,
  siteName,
  puertoRicoIconSrc,
  puertoRicoIconAccessibleLabel,
  scrollAriaLabel,
} = Astro.props;
const hasSplitHeadline = Boolean(headlinePrefix && headlineEmphasis && headlineSuffix);
---

<section
  class="relative w-full bg-hero-cupcakes bg-cover bg-center
         min-h-[360px] sm:min-h-[420px] lg:min-h-[470px] xl:min-h-[500px]
         flex flex-col items-center justify-center"
  data-node-id="3311:1437"
  data-name="Mask Group 1"
>
  <div
    class="absolute inset-0 bg-brand-pink/25 pointer-events-none"
    data-node-id="3311:1445"
    data-name="Rectangle 4 (tint)"
    aria-hidden="true"
  ></div>

  {puertoRicoIconSrc && (
    <span
      class="relative mb-4 sm:mb-5 md:mb-6
             mx-auto block h-16 sm:h-[72px] md:h-20 lg:h-24 xl:h-28 aspect-square
             bg-no-repeat bg-contain bg-center drop-shadow-md"
      style={`background-image: url("${puertoRicoIconSrc.replace(/["\\]/g, '\\$&')}")`}
      role={puertoRicoIconAccessibleLabel ? "img" : undefined}
      aria-label={puertoRicoIconAccessibleLabel}
      aria-hidden={puertoRicoIconAccessibleLabel ? undefined : "true"}
      data-name="Puerto Rico icon"
    ></span>
  )}

  <h1
    class="relative m-0 px-4 text-center text-white font-semibold leading-none drop-shadow-md"
    data-node-id="3311:1446"
    aria-label={headline}
  >
    {hasSplitHeadline ? (
      <span
        aria-hidden="true"
        class="flex w-full flex-col items-center gap-y-1 sm:grid sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-baseline sm:gap-x-4 md:gap-x-5"
      >
        <span class="text-2xl sm:justify-self-end sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl">{headlinePrefix}</span>
        <span class="text-5xl sm:justify-self-center sm:text-7xl md:text-8xl lg:text-8xl xl:text-9xl">{headlineEmphasis}</span>
        <span class="text-2xl sm:justify-self-start sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl">{headlineSuffix}</span>
      </span>
    ) : (
      <span class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl">{headline}</span>
    )}
  </h1>

  <a
    href={orderHref}
    class="relative mt-8 sm:mt-9 md:mt-10
           inline-flex items-center justify-center
           bg-brand-blue text-white font-medium no-underline
           h-12 md:h-14
           w-48 sm:w-56 md:w-60
           text-lg sm:text-xl md:text-2xl
           transition-[transform,filter] duration-150 ease-out
           hover:brightness-110 hover:-translate-y-px
           focus-visible:brightness-110 focus-visible:-translate-y-px focus-visible:outline-hidden"
    data-node-id="3311:1450"
    data-name="Rectangle 5 + ORDER NOW"
    aria-label={ctaAriaLabel}
  ><span>{ctaLabel}</span></a>

  <span
    class="absolute bottom-5 sm:bottom-6
           left-1/2 -translate-x-1/2
           bg-hero-scroll bg-no-repeat bg-contain bg-center
           w-20 sm:w-24 aspect-[137/18]
           opacity-90"
    data-node-id="3311:1444"
    data-name="Group 3"
    role="img"
    aria-label={scrollAriaLabel ?? siteName}
  ></span>
</section>
