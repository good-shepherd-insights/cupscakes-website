---
interface Props {
  accessibleHeading: string;
  quote: string;
  attribution: string;
  avatarSrc?: string;
}

const { accessibleHeading, quote, attribution, avatarSrc } = Astro.props;
---

<section
  aria-labelledby="home-review-heading"
  class="relative w-full overflow-hidden border-y border-brand-border bg-brand-pink px-4 py-12 text-center sm:px-6 md:py-16 lg:py-20"
>
  <h2 id="home-review-heading" class="sr-only">{accessibleHeading}</h2>

  <span
    class="pointer-events-none absolute left-[16%] top-4 text-[10rem] font-semibold leading-none text-white/10 sm:text-[14rem]"
    aria-hidden="true"
  >&ldquo;</span>
  <span
    class="pointer-events-none absolute right-[14%] bottom-2 text-[10rem] font-semibold leading-none text-white/10 sm:text-[14rem]"
    aria-hidden="true"
  >&rdquo;</span>

  <div class="relative mx-auto flex max-w-4xl flex-col items-center">
    {avatarSrc && (
      <div
        class="mb-6 flex h-16 w-16 items-center justify-center rounded-full border-4 border-white"
        aria-hidden="true"
      >
        <img
          src={avatarSrc}
          alt=""
          class="h-[3.75rem] w-[3.75rem] rounded-full object-cover"
        />
      </div>
    )}

    <blockquote class="m-0">
      <p class="m-0 text-4xl font-semibold leading-tight text-white sm:text-5xl lg:text-6xl">
        {quote}
      </p>
      <footer class="mt-6 text-right text-2xl font-semibold leading-tight text-white sm:text-3xl">
        <span aria-hidden="true">- </span>{attribution}
      </footer>
    </blockquote>

    <span
      class="mt-8 inline-flex h-10 w-14 items-center justify-center bg-cups-icon bg-contain bg-center bg-no-repeat"
      aria-hidden="true"
    ></span>

    <div class="mt-5 flex items-center justify-center gap-2" aria-hidden="true">
      <span class="size-3 rounded-full border border-brand-border bg-brand-blue"></span>
      <span class="size-3 rounded-full border border-brand-border bg-white"></span>
      <span class="size-3 rounded-full border border-brand-border bg-white"></span>
      <span class="size-3 rounded-full border border-brand-border bg-white"></span>
      <span class="size-3 rounded-full border border-brand-border bg-white"></span>
    </div>
  </div>
</section>
