---
interface Props {
  text?: string;
  accessibleLabel?: string;
}

const { text, accessibleLabel } = Astro.props;

const BOLD_PHRASES = ['Free Delivery', '$8 local delivery otherwise'];

function splitWithBold(input: string): { content: string; bold: boolean }[] {
  const pattern = new RegExp(`(${BOLD_PHRASES.map((p) => p.replace(/[$]/g, '\\$')).join('|')})`, 'gi');
  const parts = input.split(pattern);
  const boldSet = new Set(BOLD_PHRASES.map((p) => p.toLowerCase()));
  return parts.map((part) => ({ content: part, bold: boldSet.has(part.toLowerCase()) }));
}

const segments = text ? splitWithBold(text) : [];
---

{text && (
  <section
    class="flex min-h-12 w-full items-center justify-center bg-brand-pink px-4 py-3 text-center"
    aria-label={accessibleLabel}
  >
    <p class="m-0 text-base font-normal uppercase leading-snug text-white sm:text-lg lg:text-xl">
      {segments.map((seg) =>
        seg.bold
          ? <strong class="font-semibold">{seg.content}</strong>
          : <span>{seg.content}</span>
      )}
    </p>
  </section>
)}
