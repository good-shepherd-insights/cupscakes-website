---
interface Props {
  accessibleLabel: string;
}
const { accessibleLabel } = Astro.props;
const allFlavors = [1, 2, 3, 4, 5, 6, 7, 8, 9];
const mobileFlavors = [1, 3, 5, 7, 9];
---

<section
  class="w-full bg-brand-blue
         h-12 sm:h-14 md:h-16 lg:h-20 xl:h-24
         flex items-center"
  data-node-id="3311:1431"
  data-name="Rectangle 1 (flavor band)"
  aria-label={accessibleLabel}
>
  {/* Mobile: 5 icons with generous spacing */}
  <div class="flex lg:hidden w-full justify-around px-8 sm:px-14">
    {mobileFlavors.map((n) => (
      <span
        class="bg-flavor bg-no-repeat bg-contain bg-center h-8 sm:h-10 aspect-[118/110] shrink-0"
        data-flavor={n}
        role="img"
        aria-label={`Cupcake flavor ${n}`}
      ></span>
    ))}
  </div>

  {/* Desktop: all 9 icons */}
  <div class="hidden lg:flex w-full justify-between px-10">
    {allFlavors.map((n) => (
      <span
        class="bg-flavor bg-no-repeat bg-contain bg-center h-12 lg:h-14 xl:h-16 aspect-[118/110] shrink-0"
        data-flavor={n}
        role="img"
        aria-label={`Cupcake flavor ${n}`}
      ></span>
    ))}
  </div>
</section>
