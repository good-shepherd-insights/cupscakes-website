---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/home/Navbar.astro";
import LiveCart from "../components/cart/LiveCart.tsx";
import { loadHomePageContent } from "../lib/sanity/queries/siteContent";
import { loadOrderFlowContent } from "../lib/sanity/queries/orderFlow";

const { navbar, followUs } = await loadHomePageContent();
const { cart } = await loadOrderFlowContent();
---
<Layout title="Shopping Cart — Cups & Cakes">
  <div class="flex min-h-dvh flex-col">
    <Navbar {...navbar} facebookHref={followUs.facebookHref} instagramHref={followUs.instagramHref} />
    <LiveCart
      client:only="react"
      heading={cart.heading}
      productHeading={cart.productHeading}
      flavorHeading={cart.flavorHeading}
      occasionHeading={cart.occasionHeading}
      priceHeading={cart.priceHeading}
      qtyHeading={cart.qtyHeading}
      editLabel={cart.editLabel}
      saveLabel={cart.saveLabel}
      cancelLabel={cart.cancelLabel}
      removeLabel={cart.removeLabel}
      subtotalLabel={cart.subtotalLabel}
      checkoutLabel={cart.checkoutLabel}
      emptyMessage={cart.emptyMessage}
    />
  </div>
</Layout>
