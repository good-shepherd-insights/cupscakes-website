---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/home/Navbar.astro';
import PromoStrip from '../components/home/PromoStrip.astro';
import Hero from '../components/home/Hero.astro';
import SmallBanner from '../components/home/SmallBanner.astro';
import HomeIntro from '../components/home/HomeIntro.astro';
import HomeReview from '../components/home/HomeReview.astro';
import ReviewCta from '../components/home/ReviewCta.astro';
import OurStory from '../components/home/OurStory.astro';
import CupcakesBanner from '../components/home/CupcakesBanner.astro';
import CupcakeCarousel from '../components/home/CupcakeCarousel.astro';
import PersonalCakes from '../components/home/PersonalCakes.astro';
import FollowUs from '../components/home/FollowUs.astro';
import Footer from '../components/home/Footer.astro';
import {
  getRequiredProductBySlug,
  getRequiredProductPriceBySlug,
} from '../lib/sanity/queries/products';
import { loadHomePageContent } from '../lib/sanity/queries/siteContent';
import { resolveRequiredVariantImageUrls } from '../lib/sanity/image';
import { IMAGE_WIDTHS } from '../lib/constants';
import { resolveSeo } from '../lib/seo/resolveSeo';

const [homeContent, cupcakeProduct, personalCakePrice] = await Promise.all([
  loadHomePageContent(),
  getRequiredProductBySlug('cupcakes'),
  getRequiredProductPriceBySlug('personal-cakes'),
]);
const {
  navbar,
  promoStrip,
  hero,
  intro,
  testimonial,
  reviewCta,
  ourStory,
  cupcakesBanner,
  cupcakeCarousel,
  personalCakes,
  followUs,
  footer,
  seo,
  defaultSeo,
  siteName,
  businessIdentity,
  cssImageVars,
  faviconUrl,
  addedToCartMessage,
  addingToCartMessage,
  flavorBandAccessibleLabel,
} = homeContent;
const cupcakeImages = resolveRequiredVariantImageUrls(cupcakeProduct, IMAGE_WIDTHS.card);
const resolvedSeo = resolveSeo({
  pageKind: 'home',
  site: Astro.site,
  pathname: Astro.url.pathname,
  siteName,
  pageSeo: seo,
  defaultSeo,
  fallbackTitle: siteName,
  fallbackDescription: intro.subheading,
  fallbackImage: hero?.backgroundImage,
  businessIdentity,
});

const FEATURED_CUPCAKE_FLAVORS = ["chocolate", "butter-pecan", "carrot"];
const cupcakeFlavorGroup = cupcakeProduct.customOptions?.find((g) => g.definesVariantRoute);
const featuredCupcakeFlavors = FEATURED_CUPCAKE_FLAVORS.map((key) => {
  const option = cupcakeFlavorGroup?.options.find((o) => o.slug?.current === key);
  if (!option) {
    throw new Error(`Homepage cupcake carousel expects a "${key}" flavor option on the cupcakes product.`);
  }
  if (!option.description) {
    throw new Error(`Cupcake flavor "${key}" is missing its Sanity description.`);
  }
  return { key, name: option.label, description: option.description };
});
---
<Layout
  seo={resolvedSeo}
  faviconUrl={faviconUrl}
  cssImageVars={cssImageVars}
  addedToCartMessage={addedToCartMessage}
  addingToCartMessage={addingToCartMessage}
>
  <Navbar
    homeHref={navbar.homeHref}
    whoHref={navbar.whoHref}
    orderHref={navbar.orderHref}
    productsHref={navbar.productsHref}
    cartHref={navbar.cartHref}
    shopHref={navbar.shopHref}
    whoLabel={navbar.whoLabel}
    orderLabel={navbar.orderLabel}
    productsLabel={navbar.productsLabel}
    shopLabel={navbar.shopLabel}
    logoTextBefore={navbar.logoTextBefore}
    logoTextAfter={navbar.logoTextAfter}
    siteName={navbar.siteName}
    cartAccessibleLabel={navbar.cartAccessibleLabel}
    openMenuLabel={navbar.openMenuLabel}
    closeMenuLabel={navbar.closeMenuLabel}
    socialLinks={navbar.socialLinks}
    mobileMenuLogoSrc={navbar.mobileMenuLogoSrc}
  />
  <PromoStrip
    text={promoStrip.text}
    accessibleLabel={promoStrip.accessibleLabel}
  />
  <Hero
    headline={hero.headline}
    headlinePrefix={hero.headlinePrefix}
    headlineEmphasis={hero.headlineEmphasis}
    headlineSuffix={hero.headlineSuffix}
    ctaLabel={hero.ctaLabel}
    ctaAriaLabel={hero.ctaAriaLabel}
    orderHref={hero.orderHref}
    siteName={navbar.siteName}
    puertoRicoIconSrc={hero.puertoRicoIconSrc}
    puertoRicoIconAccessibleLabel={hero.puertoRicoIconAccessibleLabel}
    scrollAriaLabel={hero.scrollAriaLabel}
  />
  <SmallBanner accessibleLabel={flavorBandAccessibleLabel} />
  <HomeReview
    accessibleHeading={testimonial.accessibleHeading}
    reviews={testimonial.reviews}
  />
  <HomeIntro
    heading={intro.heading}
    subheading={intro.subheading}
  />
  <ReviewCta
    heading={reviewCta.heading}
    ctaLabel={reviewCta.ctaLabel}
    ctaHref={reviewCta.ctaHref}
    ctaAriaLabel={reviewCta.ctaAriaLabel}
  />
  <OurStory
    heading={ourStory.heading}
    paragraphs={ourStory.paragraphs}
    photoSrc={ourStory.photoSrc}
    logoSrc={ourStory.logoSrc}
  />
  <CupcakesBanner headline={cupcakesBanner.headline} />
  <CupcakeCarousel
    caption={cupcakeCarousel.caption}
    otherOptionsHref={cupcakeCarousel.otherOptionsHref}
    otherOptionsLabel={cupcakeCarousel.otherOptionsLabel}
    ctaLabel={hero.ctaLabel}
    price={cupcakeProduct.price}
    images={cupcakeImages}
    flavors={featuredCupcakeFlavors}
  />
  <PersonalCakes
    heading={personalCakes.heading}
    caption={personalCakes.caption}
    flavorHeadline={personalCakes.flavorHeadline}
    price={personalCakePrice}
    chocolateHref={personalCakes.chocolateHref}
    chocolateLabel={personalCakes.chocolateLabel}
    vanillaHref={personalCakes.vanillaHref}
    vanillaLabel={personalCakes.vanillaLabel}
    flavorLinks={personalCakes.flavorLinks}
    ampImageSrc={personalCakes.ampImageSrc}
    logoSrc={personalCakes.logoSrc}
    photoSrc={personalCakes.photoSrc}
  />
  <FollowUs
    heading={followUs.heading}
    socialLinks={followUs.socialLinks}
  />
  <Footer
    whoHref={footer.whoHref}
    orderHref={footer.orderHref}
    topHref={footer.topHref}
    whoLabel={footer.whoLabel}
    orderLabel={footer.orderLabel}
    topLabel={footer.topLabel}
    copyright={footer.copyright}
    socialLinks={footer.socialLinks}
  />
</Layout>
