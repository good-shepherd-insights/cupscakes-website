---
// WIP — the current loading screen does not match Figma 3311:5499.
// Do not link to it from production navigation until redone.
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/home/Navbar.astro";
import Loading from "../../components/order/Loading.astro";
import { loadHomePageContent } from "../../lib/sanity/queries/siteContent";
import { loadOrderFlowContent } from "../../lib/sanity/queries/orderFlow";
import { resolveSeo } from "../../lib/seo/resolveSeo";

const { navbar, followUs, decorativeMarks, siteName, addedToCartMessage, addingToCartMessage } = await loadHomePageContent();
const { loading } = await loadOrderFlowContent();
const resolvedSeo = resolveSeo({
  pageKind: 'utility',
  site: Astro.site,
  pathname: Astro.url.pathname,
  siteName,
  fallbackTitle: `Loading [WIP] — ${siteName}`,
});
---
<Layout seo={resolvedSeo} addedToCartMessage={addedToCartMessage} addingToCartMessage={addingToCartMessage}>
  <div class="flex min-h-dvh flex-col">
    <Navbar {...navbar} activeLink="order" />
    <Loading {...loading} logoSmallSrc={decorativeMarks.smallSrc} logoSmallAlt={decorativeMarks.smallAlt} />
    <noscript>
      <p class="px-4 py-3 text-center text-sm text-black">
        {loading.loadingLabel} <a class="underline text-brand-blue-dark" href={loading.redirectHref}>{loading.continueLabel}</a>
      </p>
    </noscript>
  </div>
</Layout>
