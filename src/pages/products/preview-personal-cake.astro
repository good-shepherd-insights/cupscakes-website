---
// TEMP — delete when Sanity is live
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/home/Navbar.astro";
import Footer from "../../components/home/Footer.astro";
import PersonalCakeProduct from "../../components/product/PersonalCakeProduct.astro";
import { loadHomePageContent } from "../../lib/sanity/queries/siteContent";
import { formatProductPrice } from "../../lib/format/productPrice";
import { getRequiredProductPriceBySlug } from "../../lib/sanity/queries/products";
import { resolveSeo } from "../../lib/seo/resolveSeo";

const { navbar, footer, followUs, addToCartLabel, siteName, addedToCartMessage, addingToCartMessage } = await loadHomePageContent();
const personalCakePrice = await getRequiredProductPriceBySlug("personal-cakes");
const resolvedSeo = resolveSeo({
  pageKind: 'utility',
  site: Astro.site,
  pathname: Astro.url.pathname,
  siteName,
  fallbackTitle: `Personal Cake — ${siteName}`,
});
---

<Layout seo={resolvedSeo} addedToCartMessage={addedToCartMessage} addingToCartMessage={addingToCartMessage}>
  <div class="flex min-h-dvh flex-col">
    <Navbar {...navbar} mode="store" activeLink="products" />
    <PersonalCakeProduct
      breadcrumbHrefHome={navbar.homeHref}
      breadcrumbHrefProducts={navbar.productsHref}
      breadcrumbHomeLabel={navbar.homeLabel}
      breadcrumbProductsLabel={navbar.productsLabel}
      breadcrumbLabel="Personal Cakes"
      title="Personal Cake"
      subtitle="Small in size but big in bringing joy to each bite!"
      servingInfo="Serves 3-4 people."
      imageSrc="/assets/personal-cake-product.png"
      imageAlt="Personal cake with pink frosting"
      customOptions={[
        { name: "Flavor", inputType: "radio", options: ["Chocolate", "Vanilla"].map((label) => ({ label })) },
        {
          name: "Frosting Color",
          inputType: "checkbox",
          helperText: "(please choose up to 2 colors)",
          options: ["Red", "Blue", "Green", "Yellow", "Purple", "Pink", "White"]
            .map((label) => ({ label }))
            .concat({ label: "Custom", priceModifier: 3 }),
        },
        { name: "Occasion", inputType: "radio", options: ["Regular", "Birthday", "Wedding", "Holiday", "Other"].map((label) => ({ label })) },
      ]}
      price={formatProductPrice(personalCakePrice)}
      addToCartLabel={addToCartLabel}
    />
    <Footer {...footer} />
  </div>
</Layout>
